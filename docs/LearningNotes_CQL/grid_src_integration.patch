+class _GridResponse:
+    """Minimal stand-in for a Fingrid API response."""
+
+    def __init__(self, rows, status=200):
+        self._rows = rows
+        self.status_code = status
+
+    def raise_for_status(self):
+        if self.status_code >= 400:
+            raise RuntimeError(f'HTTP {self.status_code}')
+
+    def json(self):
+        return {'data': self._rows}
+
+
+class FetchGridTests(unittest.TestCase):
+    def setUp(self):
+        self.start = pd.Timestamp('2026-07-10 00:00', tz='Europe/Helsinki')
+
+    @patch('fetch_live.config.FINGRID_API_KEY', 'test-key')
+    @patch('fetch_live.requests.get')
+    def test_fetch_grid_derives_flow_columns(self, get):
+        # one page of 4 quarter-hour rows per dataset (IDs 55/57/60/61)
+        values = {55: 10.0, 57: 20.0, 60: 30.0, 61: 40.0}
+
+        def fake_get(url, headers=None, params=None, timeout=None):
+            dataset_id = int(url.split('/datasets/')[1].split('/')[0])
+            rows = [{
+                'startTime': (self.start + pd.Timedelta(minutes=15 * i))
+                             .tz_convert('UTC').strftime('%Y-%m-%dT%H:%M:%SZ'),
+                'value': values[dataset_id],
+            } for i in range(4)]
+            return _GridResponse(rows)
+
+        get.side_effect = fake_get
+
+        result = fetch_live.fetch_grid_transmission(
+            self.start, self.start + pd.Timedelta(hours=1))
+
+        for col in ['fi_ee', 'fi_no', 'fi_se_north', 'fi_se_central',
+                    'fi_se_total', 'fi_total_net', 'fi_se_abs']:
+            self.assertIn(col, result.columns)
+        self.assertAlmostEqual(result['fi_total_net'].iloc[0], 100.0)  # 10+20+30+40
+        self.assertAlmostEqual(result['fi_se_total'].iloc[0], 70.0)    # 30+40
+        self.assertAlmostEqual(result['fi_se_abs'].iloc[0], 70.0)
+        self.assertEqual(str(result.index.tz), 'Europe/Helsinki')
