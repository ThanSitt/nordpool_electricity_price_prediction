+# ── grid buffer ────────────────────────────────────────────────────────────────
+
+GRID_FLOW_COLS = ['fi_ee', 'fi_no', 'fi_se_north', 'fi_se_central',
+                  'fi_se_total', 'fi_total_net', 'fi_se_abs']
+
+
+class GridBuffer:
+    """
+    Rolling store of 15-minute cross-border grid flows (MW), indexed in
+    Helsinki time.
+
+    Only MEASURED history is held here.  For a future forecast timestamp the
+    current-period flows are not published yet, so ``get`` returns NaN; the
+    lag features (lag_96 = 24h, lag_672 = 7d) remain computable from history.
+    """
+
+    def __init__(self, df: pd.DataFrame | None = None):
+        self._df = df.copy() if df is not None else pd.DataFrame()
+        if not self._df.empty:
+            if self._df.index.tz is None:
+                self._df.index = self._df.index.tz_localize(_HELSINKI)
+            else:
+                self._df.index = self._df.index.tz_convert(_HELSINKI)
+            self._df = self._df[~self._df.index.duplicated(keep='last')].sort_index()
+
+    @staticmethod
+    def _snap(ts) -> pd.Timestamp:
+        ts = pd.Timestamp(ts)
+        if ts.tzinfo is None:
+            ts = ts.tz_localize(_HELSINKI)
+        else:
+            ts = ts.tz_convert(_HELSINKI)
+        m = (ts.minute // 15) * 15
+        return ts.replace(minute=m, second=0, microsecond=0)
+
+    def _row(self, ts):
+        key = self._snap(ts)
+        if key in self._df.index:
+            return self._df.loc[key]
+        return None
+
+    def get(self, ts) -> dict:
+        """Current-period flows at ``ts``; NaN for any slot without a measurement."""
+        row = self._row(ts)
+        if row is None:
+            return {col: np.nan for col in GRID_FLOW_COLS}
+        return {col: float(row[col]) for col in GRID_FLOW_COLS}
+
+    def lag_steps(self, ts, steps: int, col: str) -> float:
+        """Value of a grid column ``steps`` x 15-min earlier (NaN if unknown)."""
+        row = self._row(ts - pd.Timedelta(minutes=15 * steps))
+        if row is None or col not in row:
+            return np.nan
+        return float(row[col])
+
+
