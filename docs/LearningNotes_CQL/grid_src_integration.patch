+# --- Fingrid cross-border grid transmission ------------------------------------
+
+def _fetch_fingrid_dataset(dataset_id: int, start: pd.Timestamp,
+                           end: pd.Timestamp) -> pd.Series:
+    """Fetch one Fingrid Open Data dataset as a 15-min Series in Helsinki time.
+
+    Mirrors the paging + 429-retry pattern from ``15min_GridTransmission.ipynb``.
+    Requires ``config.FINGRID_API_KEY``; raises if it is missing.
+    """
+    if not config.FINGRID_API_KEY:
+        raise RuntimeError('FINGRID_API_KEY is not set; cannot fetch grid data')
+
+    url = f'{config.FINGRID_API_URL}/datasets/{dataset_id}/data'
+    headers = {'x-api-key': config.FINGRID_API_KEY}
+    start_utc = start.tz_convert('UTC').strftime('%Y-%m-%dT%H:%M:%SZ')
+    end_utc = end.tz_convert('UTC').strftime('%Y-%m-%dT%H:%M:%SZ')
+
+    rows: list[dict] = []
+    page = 1
+    while True:
+        for attempt in range(5):
+            response = requests.get(
+                url, headers=headers,
+                params={'startTime': start_utc, 'endTime': end_utc,
+                        'format': 'json', 'pageSize': 10000, 'page': page},
+                timeout=_TIMEOUT)
+            if response.status_code == 429:
+                wait = 60 * (attempt + 1)
+                print(f'  Fingrid 429 rate limit — waiting {wait}s before retry {attempt + 1}/5 ...')
+                time.sleep(wait)
+                continue
+            response.raise_for_status()
+            break
+        else:
+            raise RuntimeError(f'Fingrid dataset {dataset_id} page {page}: still 429 after 5 retries')
+        body = response.json()
+        batch = body.get('data', [])
+        rows.extend(batch)
+        if len(batch) < 10000:
+            break
+        page += 1
+        time.sleep(2)
+
+    if not rows:
+        return pd.Series(dtype=float, name='value')
+
+    records = {}
+    for row in rows:
+        try:
+            ts = pd.to_datetime(row['startTime'], utc=True).tz_convert(_HELSINKI)
+            records[ts] = float(row['value'])
+        except (KeyError, TypeError, ValueError):
+            continue
+    series = pd.Series(records, name='value', dtype=float).sort_index()
+    return series[~series.index.duplicated(keep='last')]
+
+
+def fetch_grid_transmission(start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:
+    """Return the 7 derived cross-border flow columns at 15-min resolution.
+
+    Fetches the four measured corridors (EE/NO/SE1/SE3), derives the combined
+    Sweden total, the total net flow, and the SE absolute value — matching the
+    columns used in ``V3_15min_feature_engineering.ipynb``.
+    """
+    start, end = _to_helsinki(start), _to_helsinki(end)
+
+    raw: dict[str, pd.Series] = {}
+    for name, dataset_id in config.FINGRID_GRID_DATASETS.items():
+        try:
+            series = _fetch_fingrid_dataset(dataset_id, start, end)
+        except Exception as exc:
+            print(f'  WARNING: Fingrid grid fetch failed for {name} (dataset {dataset_id}): {exc}')
+            series = pd.Series(dtype=float)
+        if series.empty:
+            print(f'  WARNING: no grid data for {name} (dataset {dataset_id})')
+        raw[name] = series
+
+    if not raw or all(s.empty for s in raw.values()):
+        return pd.DataFrame(columns=config.GRID_FLOW_COLS)
+
+    # union of all timestamps, then forward-fill small gaps onto a 15-min grid
+    index = pd.DatetimeIndex(
+        sorted({ts for s in raw.values() for ts in s.index})).tz_convert(_HELSINKI)
+    frame = pd.DataFrame(index=index, dtype=float)
+    for name, series in raw.items():
+        frame[name] = series.reindex(index)
+    frame = frame.ffill().bfill()
+
+    grid_15 = frame.resample('15min').last()
+    grid_15 = grid_15[~grid_15.index.duplicated(keep='last')]
+
+    result = pd.DataFrame(index=grid_15.index)
+    result['fi_ee'] = grid_15['fi_ee']
+    result['fi_no'] = grid_15['fi_no']
+    result['fi_se_north'] = grid_15['fi_se_north']
+    result['fi_se_central'] = grid_15['fi_se_central']
+    result['fi_se_total'] = grid_15['fi_se_north'] + grid_15['fi_se_central']
+    result['fi_total_net'] = grid_15[['fi_ee', 'fi_no', 'fi_se_north', 'fi_se_central']].sum(axis=1)
+    result['fi_se_abs'] = result['fi_se_total'].abs()
+    return result[config.GRID_FLOW_COLS]
