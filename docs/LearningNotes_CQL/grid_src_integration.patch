+class GridBufferTests(unittest.TestCase):
+    def setUp(self):
+        index = pd.date_range('2026-01-01 00:00', periods=8, freq='15min', tz='Europe/Helsinki')
+        df = pd.DataFrame({
+            'fi_ee':        np.arange(8, dtype=float),
+            'fi_no':        np.full(8, 100.0),
+            'fi_se_north':  np.full(8, 200.0),
+            'fi_se_central': np.full(8, 300.0),
+            'fi_se_total':  np.full(8, 500.0),
+            'fi_total_net': np.full(8, 700.0),
+            'fi_se_abs':    np.full(8, 500.0),
+        }, index=index)
+        self.buffer = features.GridBuffer(df)
+        self.ts = index[6]
+
+    def test_get_returns_current_period_flows(self):
+        flows = self.buffer.get(self.ts)
+        self.assertEqual(flows['fi_ee'], 6.0)
+        self.assertEqual(flows['fi_no'], 100.0)
+
+    def test_get_returns_nan_for_future_slot(self):
+        flows = self.buffer.get(self.ts + pd.Timedelta(hours=1))
+        self.assertTrue(np.isnan(flows['fi_ee']))
+
+    def test_lag_steps_uses_preceding_slots(self):
+        # lag_4 = 4 x 15min = 1 hour earlier -> the slot at index 2
+        self.assertEqual(self.buffer.lag_steps(self.ts, 4, 'fi_ee'), 2.0)
+        # lag_96 = 24h earlier -> outside the 2h buffer -> NaN
+        self.assertTrue(np.isnan(self.buffer.lag_steps(self.ts, 96, 'fi_total_net')))
+
+    def _features(self, grid):
+        price_idx = pd.date_range('2026-01-01 00:00', periods=200, freq='15min', tz='Europe/Helsinki')
+        prices = pd.Series(10.0, index=price_idx)
+        wx_idx = pd.date_range('2026-01-01 00:00', periods=48, freq='h', tz='Europe/Helsinki')
+        wx = pd.DataFrame({'temp': 5.0, 'wind_speed': 2.0, 'wind_direction_deg': 180.0}, index=wx_idx)
+        return features.build_features(self.ts, features.PriceBuffer(prices),
+                                       features.WeatherBuffer(wx), grid)
+
+    def test_build_features_returns_nan_grid_without_buffer(self):
+        f = self._features(None)
+        self.assertTrue(np.isnan(f['fi_ee']))
+        self.assertTrue(np.isnan(f['fi_total_net_lag_672']))
+        self.assertTrue(np.isnan(f['fi_se_total_lag_96']))
+
+    def test_build_features_with_grid_provides_flows_and_lags(self):
+        f = self._features(self.buffer)
+        self.assertEqual(f['fi_ee'], 6.0)                          # current period from history
+        self.assertEqual(f['fi_se_total'], 500.0)
+        self.assertEqual(f['fi_total_net'], 700.0)
+        # grid lags are 96/672 steps (24h / 7d), outside the 2h buffer -> NaN
